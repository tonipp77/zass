<Window x:Class="Zass.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Segoe UI" FontSize="13">

    <StackPanel Margin="24">
        <TextBlock Text="Zass" FontSize="26" FontWeight="Bold" />
        <TextBlock x:Name="VersionText" Foreground="Gray" Margin="0,2,0,0" />
        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="20" />
        <Button x:Name="CloseButton" MinWidth="88" Height="28" Margin="0,22,0,0"
                HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
    </StackPanel>
</Window>

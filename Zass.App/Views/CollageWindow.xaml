<Window x:Class="Zass.App.Views.CollageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="clr-namespace:Zass.App.Overlay"
        Width="1060" Height="740" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock x:Name="Hint" TextWrapping="Wrap" Foreground="#525866" Margin="0,0,0,14" />
            <WrapPanel x:Name="DrawingTools">
                <ToggleButton x:Name="PointerTool" Click="OnPointerTool" IsChecked="True" />
                <ToggleButton x:Name="CurvedTool" Click="OnCurvedTool" />
                <ToggleButton x:Name="StraightTool" Click="OnStraightTool" />
                <ToggleButton x:Name="ElbowTool" Click="OnElbowTool" />
                <ToggleButton x:Name="TextTool" Click="OnTextTool" />
                <Button x:Name="ColorButton" Click="OnColorClick">
                    <Border x:Name="ColorSwatch" Width="24" Height="16" Background="Red" />
                </Button>
                <TextBlock x:Name="SizeLabel" Margin="4,0" VerticalAlignment="Center" />
                <Slider x:Name="SizeSlider" Width="90" Minimum="8" Maximum="48" Value="16"
                        TickFrequency="1" IsSnapToTickEnabled="True" Focusable="False" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ElementName=SizeSlider, Path=Value, StringFormat=F0}"
                           Width="30" Margin="4,0" VerticalAlignment="Center" />
                <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="OnColorPopupClosed">
                    <Border Background="#F02A2A2A" Padding="10" CornerRadius="6">
                        <overlay:ColorPicker x:Name="ColorPickerControl" />
                    </Border>
                </Popup>
            </WrapPanel>
            <WrapPanel>
                <Button x:Name="CaptureButton" Click="OnCapture" />
                <Button x:Name="RemoveButton" Click="OnRemove" />
                <Button x:Name="UndoButton" Click="OnUndo" />
                <Button x:Name="RedoButton" Click="OnRedo" />
                <Button x:Name="ClearButton" Click="OnClear" />
            </WrapPanel>
            <WrapPanel Margin="0,4,0,10">
                <Button x:Name="CopyButton" Click="OnCopy" />
                <Button x:Name="SaveButton" Click="OnSave" />
                <Button x:Name="HideButton" Click="OnHide" />
                <TextBlock x:Name="ZoomLabel" VerticalAlignment="Center" Margin="8,0" />
                <Slider x:Name="ZoomSlider" Width="120" Minimum="0.1" Maximum="2" Value="0.5"
                        Focusable="False" VerticalAlignment="Center" ValueChanged="OnZoomChanged" />
                <TextBlock x:Name="ZoomValue" Width="52" VerticalAlignment="Center" Margin="8,0" />
            </WrapPanel>
        </StackPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,10,0,0" />
        <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#D7DBE0" Focusable="False">
            <Canvas x:Name="Surface" Background="White" HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseLeftButtonDown="OnSurfaceDown" MouseMove="OnSurfaceMove"
                    MouseLeftButtonUp="OnSurfaceUp" LostMouseCapture="OnSurfaceLostCapture">
                <Canvas.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="0.5" ScaleY="0.5" />
                </Canvas.LayoutTransform>
            </Canvas>
        </ScrollViewer>
    </DockPanel>
</Window>

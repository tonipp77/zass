<Window x:Class="Zass.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zass.App.Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        SnapsToDevicePixels="True"
        UseLayoutRounding="False">

    <Window.Resources>
        <!-- Floating toolbar tool button: flat, with hover and active (checked) states. -->
        <Style x:Key="ToolButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3C8DE5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat chrome button (no checked state); used for the color swatch button. -->
        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small caption text used by the toolbar option labels/values. -->
        <Style x:Key="ToolbarCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Layer 1: frozen monitor capture at full brightness -->
        <Image x:Name="BackgroundImage" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <!-- Layer 2: dimming with a "hole" over the selection -->
        <Canvas x:Name="DimCanvas" ClipToBounds="True">
            <Path x:Name="DimPath" Fill="#80000000" />
        </Canvas>

        <!-- Layer 3: live vector annotations (above the dim, at full brightness) -->
        <Canvas x:Name="AnnotationCanvas" ClipToBounds="True" />

        <!-- Layer 4: selection chrome (border, handles, dimensions) + floating toolbar -->
        <Canvas x:Name="ChromeCanvas" ClipToBounds="True">
            <Rectangle x:Name="SelectionBorder"
                       Stroke="#FF3C8DE5" StrokeThickness="1"
                       Visibility="Collapsed" />

            <Border x:Name="DimensionLabel"
                    Background="#CC000000" CornerRadius="3"
                    Padding="6,2" Visibility="Collapsed">
                <TextBlock x:Name="DimensionText"
                           Foreground="White" FontSize="12" FontFamily="Segoe UI" />
            </Border>

            <Border x:Name="Toolbar" Visibility="Collapsed"
                    Background="#E6202020" CornerRadius="6" Padding="4"
                    BorderBrush="#40FFFFFF" BorderThickness="1"
                    MouseLeftButtonDown="OnToolbarMouseDown">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="PointerToolButton" Style="{StaticResource ToolButtonStyle}"
                                  Focusable="False" Click="OnPointerToolClick">
                        <Path Data="M 0,0 L 0,16 L 4,12 L 7,18 L 9,17 L 6,11 L 11,11 Z"
                              Fill="White" Stretch="Uniform" Width="14" Height="16" />
                    </ToggleButton>
                    <ToggleButton x:Name="TextToolButton" Style="{StaticResource ToolButtonStyle}"
                                  Focusable="False" Margin="2,0,0,0" Click="OnTextToolClick">
                        <Path Data="M2,3 L14,3 M8,3 L8,15" Stroke="White" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="None" />
                    </ToggleButton>
                    <ToggleButton x:Name="ArrowToolButton" Style="{StaticResource ToolButtonStyle}"
                                  Focusable="False" Margin="2,0,0,0" Click="OnArrowToolClick">
                        <Path Data="M2,14 L14,2 M14,2 L8.5,2.5 M14,2 L13.5,7.5" Stroke="White" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16" Stretch="None" />
                    </ToggleButton>
                    <ToggleButton x:Name="RectangleToolButton" Style="{StaticResource ToolButtonStyle}"
                                  Focusable="False" Margin="2,0,0,0" Click="OnRectangleToolClick">
                        <Rectangle Width="16" Height="12" Stroke="White" StrokeThickness="1.5" Fill="Transparent" />
                    </ToggleButton>
                    <ToggleButton x:Name="FilledRectangleToolButton" Style="{StaticResource ToolButtonStyle}"
                                  Focusable="False" Margin="2,0,0,0" Click="OnFilledRectangleToolClick">
                        <Rectangle Width="16" Height="12" Fill="White" />
                    </ToggleButton>
                    <ToggleButton x:Name="FreehandToolButton" Style="{StaticResource ToolButtonStyle}"
                                  Focusable="False" Margin="2,0,0,0" Click="OnFreehandToolClick">
                        <Path Data="M1,10 C3,3 5,3 7,8 C9,13 11,13 15,5" Stroke="White" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16" Stretch="None" />
                    </ToggleButton>

                    <!-- Color / size options (shown contextually for the active tool) -->
                    <Border x:Name="OptionsSeparator" Width="1" Margin="5,3" Background="#40FFFFFF" />

                    <Button x:Name="ColorButton" Style="{StaticResource ChromeButtonStyle}" Click="OnColorButtonClick">
                        <Border x:Name="ColorSwatch" Width="18" Height="18" CornerRadius="3"
                                Background="Red" BorderBrush="#80FFFFFF" BorderThickness="1" />
                    </Button>

                    <StackPanel x:Name="ThicknessPanel" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ThicknessLabel" Style="{StaticResource ToolbarCaption}" Margin="0,0,5,0" />
                        <Slider x:Name="ThicknessSlider" Width="84" Minimum="1" Maximum="20" Value="3"
                                IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False"
                                VerticalAlignment="Center" ValueChanged="OnThicknessChanged" />
                        <TextBlock x:Name="ThicknessValue" Style="{StaticResource ToolbarCaption}"
                                   Foreground="White" Width="22" TextAlignment="Right" Margin="5,0,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="TextSizePanel" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TextSizeLabel" Style="{StaticResource ToolbarCaption}" Margin="0,0,5,0" />
                        <Slider x:Name="TextSizeSlider" Width="84" Minimum="8" Maximum="72" Value="18"
                                IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False"
                                VerticalAlignment="Center" ValueChanged="OnTextSizeChanged" />
                        <TextBlock x:Name="TextSizeValue" Style="{StaticResource ToolbarCaption}"
                                   Foreground="White" Width="22" TextAlignment="Right" Margin="5,0,0,0" />
                    </StackPanel>

                    <!-- Export actions (always visible): copy, save, cancel -->
                    <Border x:Name="ActionsSeparator" Width="1" Margin="5,3" Background="#40FFFFFF" />

                    <Button x:Name="CopyButton" Style="{StaticResource ChromeButtonStyle}" Click="OnCopyClick">
                        <Grid Width="16" Height="16">
                            <Rectangle Width="9" Height="11" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="White" StrokeThickness="1.4" Fill="Transparent"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Rectangle Width="9" Height="11" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="White" StrokeThickness="1.4" Fill="#FF202020"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>

                    <Button x:Name="SaveButton" Style="{StaticResource ChromeButtonStyle}" Click="OnSaveClick">
                        <Path Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="None"
                              Data="M8,2 L8,10 M4.5,6.5 L8,10.5 L11.5,6.5 M2.5,13 L13.5,13" />
                    </Button>

                    <Button x:Name="CloseButton" Style="{StaticResource ChromeButtonStyle}" Click="OnCloseClick">
                        <Path Stroke="White" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="None"
                              Data="M2,2 L12,12 M12,2 L2,12" />
                    </Button>

                    <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           HorizontalOffset="-6" VerticalOffset="4" Closed="OnColorPopupClosed">
                        <Border Background="#F02A2A2A" CornerRadius="6" Padding="8" Margin="8"
                                BorderBrush="#40FFFFFF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
                            </Border.Effect>
                            <local:ColorPicker x:Name="ColorPickerControl" />
                        </Border>
                    </Popup>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>

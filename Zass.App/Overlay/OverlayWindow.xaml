<Window x:Class="Zass.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        SnapsToDevicePixels="True"
        UseLayoutRounding="False">

    <Grid>
        <!-- Layer 1: frozen monitor capture at full brightness -->
        <Image x:Name="BackgroundImage" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <!-- Layers 2-3: dimming with a "hole" over the selection + selection border -->
        <Canvas x:Name="OverlayCanvas" ClipToBounds="True">
            <Path x:Name="DimPath" Fill="#80000000" />

            <Rectangle x:Name="SelectionBorder"
                       Stroke="#FF3C8DE5" StrokeThickness="1"
                       Visibility="Collapsed" />

            <Border x:Name="DimensionLabel"
                    Background="#CC000000" CornerRadius="3"
                    Padding="6,2" Visibility="Collapsed">
                <TextBlock x:Name="DimensionText"
                           Foreground="White" FontSize="12" FontFamily="Segoe UI" />
            </Border>
        </Canvas>
    </Grid>
</Window>

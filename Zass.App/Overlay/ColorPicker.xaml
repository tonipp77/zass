<UserControl x:Class="Zass.App.Overlay.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="196">
    <StackPanel>
        <!-- Quick palette of common colors (filled in code-behind) -->
        <WrapPanel x:Name="PalettePanel" Width="196" />

        <!-- Saturation / value area for the current hue -->
        <Border x:Name="SvArea" Width="196" Height="120" Margin="0,8,0,0"
                CornerRadius="3" ClipToBounds="True" Cursor="Cross"
                MouseLeftButtonDown="OnSvMouseDown" MouseMove="OnSvMouseMove"
                MouseLeftButtonUp="OnSvMouseUp">
            <Grid>
                <Rectangle x:Name="SvHueLayer" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas>
                    <Ellipse x:Name="SvThumb" Width="12" Height="12" IsHitTestVisible="False"
                             Stroke="White" StrokeThickness="2" />
                </Canvas>
            </Grid>
        </Border>

        <!-- Hue strip -->
        <Border x:Name="HueStrip" Width="196" Height="14" Margin="0,8,0,0"
                CornerRadius="3" ClipToBounds="True" Cursor="Cross"
                MouseLeftButtonDown="OnHueMouseDown" MouseMove="OnHueMouseMove"
                MouseLeftButtonUp="OnHueMouseUp">
            <Grid>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                            <GradientStop Color="#FF00FF00" Offset="0.3333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.6667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas>
                    <Rectangle x:Name="HueThumb" Width="4" Height="14" IsHitTestVisible="False"
                               Stroke="White" StrokeThickness="1.5" Fill="#80000000" />
                </Canvas>
            </Grid>
        </Border>

        <!-- Hex input -->
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock x:Name="HexLabel" Foreground="#CCFFFFFF" FontFamily="Segoe UI" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="HexBox" Width="92" FontFamily="Consolas" FontSize="12"
                     Background="#22FFFFFF" Foreground="White" BorderBrush="#40FFFFFF" BorderThickness="1"
                     Padding="3,2" PreviewKeyDown="OnHexPreviewKeyDown" LostKeyboardFocus="OnHexLostFocus" />
        </StackPanel>
    </StackPanel>
</UserControl>
